# Mac App Store command-line interface
brew "mas"

# ── Version / tool manager ────────────────────────────────────────────────────
# mise manages all CLI tools and language runtimes (see ~/.config/mise/config.toml).
# Homebrew-installed so it lands in /opt/homebrew/bin and is present before
# ensure_mise runs; the curl fallback in ensure_mise is then a no-op on macOS.
brew "mise"

# ── Bootstrap / git — every mac ───────────────────────────────────────────────
# Must exist before mise runs. stow/git-crypt bootstrap the dotfiles themselves
# (ensure_macos_prereqs also installs them directly; brew bundle is idempotent).
# git-lfs is managed by mise (aqua:git-lfs/git-lfs) — see base mise config.
brew "stow"
brew "git"
brew "git-crypt"
brew "gnupg"
brew "pinentry-mac"

# ── Shell ─────────────────────────────────────────────────────────────────────
# fish must be Homebrew-installed so it can be set as login shell via chsh.
brew "fish"

# ── Core desktop apps — all macs ─────────────────────────────────────────────
# Cross-platform set: keep in sync with os/wsl/windows/winget.txt — check.sh
# asserts the cask ↔ winget-ID parity mapping.
cask "alacritty"        # terminal emulator
cask "bitwarden"        # password/key vault
cask "brave-browser"    # primary browser
cask "obsidian"         # notes
# Paseo bundles its own daemon AND CLI (Homebrew links that bundle's `paseo`
# binary onto PATH, and the app drops ~/.local/bin/paseo itself — nothing here
# provisions the CLI). The daemon's config is tracked per host:
# hosts/<host>/paseo/.paseo/config.json. The cask is auto_updates (verified in the
# API JSON: `brew info --cask --json=v2 paseo` → auto_updates true), so Paseo
# updates itself and brew only records ownership. A host that installed the dmg
# by hand needs no migration: `brew bundle` passes `--adopt` for casks by default
# (Library/Homebrew/bundle/installer.rb), which takes ownership without touching
# /Applications — and, for auto_updates casks, without comparing versions.
cask "paseo"            # AI agent daemon + desktop client
# Flameshot comes from its own tap: homebrew/cask disabled the canonical cask
# (disable! date: "2026-09-01", :fails_gatekeeper_check) because upstream ships
# an ad-hoc-signed, unnotarized DMG. The tap pins the same release digests the
# disabled cask did (arm64 ff2f63fb…, intel bb3ba6c0…). `trusted: true` is
# required: Homebrew 7 refuses to load a cask from an untrusted third-party tap,
# and trust otherwise lives in host-local ~/.homebrew/trust.json.
tap "flameshot-org/flameshot"
cask "flameshot-org-flameshot", trusted: true  # cross-platform screenshots
cask "telegram"         # messaging
cask "vscodium"         # editor — canonical extensions list: os/wsl/windows/vscodium/extensions.txt
# ZapFast (WhatsApp client) ships from its author's tap, not homebrew/cask.
# No winget twin: microsoft/winget-pkgs has no ZapFast manifest
# (manifests/c/crmne holds TonePush only). The Windows side is seeded by the
# pinned-MSI block in os/wsl/up.sh, not by winget.txt.
tap "crmne/tap"
cask "zapfast"
cask "firefox@developer-edition"  # secondary browser (parity with winget)
# No winget twin — one-off mac utility, kept out of the parity table.
cask "appcleaner"           # app uninstaller for stray-app cleanup

# ── Tiling window manager ─────────────────────────────────────────────────────
# AeroSpace is the primary WM on all macs (matches komorebi on Windows) and
# starts via its own launch-on-login setting. Host-specific aerospace.toml
# lives in hosts/<host>/aerospace.
tap "nikitabobko/tap"
cask "aerospace"

# ── CLI tools not in mise/aqua ────────────────────────────────────────────────
# No mise registry entry and no prebuilt binaries for the ubi backend — must
# come from the OS package manager on every platform (brew on macOS,
# ensure_system_tools on Linux/WSL). lf moved to mise (ubi:gokcehan/lf).
brew "tig"              # text-mode git log/diff browser
brew "make"             # GNU Make as `gmake`. macOS ships 3.81 at /usr/bin/make;
                        # gmake is the only route to a modern GNU make.
                        # Needed by the FLEET, not by the workbench: the IaC repo's
                        # Makefile uses $(abspath) (Make 4.0+) and two work repos
                        # use .ONESHELL (4.x-only). Both degrade SILENTLY on 3.81
                        # — abspath expands empty; .ONESHELL is ignored, so every
                        # recipe line gets its own shell. Which repos those are is
                        # recorded in the workbench, never in this public tree.
                        # Declared for the `gmake` binary, not `make` — the brew
                        # formula is keg-only for `make`, so nothing is shadowed.
brew "graphviz"         # graph visualization library
brew "btop"             # system monitor — aqua/github releases ship linux builds only; macOS has no prebuilt binary, so brew (Linux/WSL uses mise aqua)
brew "navi"             # cheatsheet browser — same shape as btop: aqua publishes
                        # linux + windows/amd64 only, so `mise install navi` fails
                        # on Apple Silicon. See [tools.navi] os restriction.
brew "wireguard-tools"  # VPN (also in ensure_system_tools on Linux/WSL)
brew "pstree"           # process tree viewer (also in ensure_system_tools)
brew "mosh"             # mobile shell — roaming/offline SSH (also in ensure_system_tools)

# ── Fonts ─────────────────────────────────────────────────────────────────────
# Cascadia Code patched with Nerd Font glyphs. Referenced in alacritty and
# VSCodium configs. Must be the same font across all platforms.
cask "font-caskaydia-cove-nerd-font"
