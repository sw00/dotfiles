# Fisher writes plugin files at runtime. Only our own files are tracked.
# Run `fisher update` (or bootstrap.sh) to reinstall plugins after cloning.
#
# Tracked:  config.fish, fish_plugins, fish_variables, conf.d/ssh-agent.fish,
#           conf.d/ssh-locale.fish, conf.d/wsl.fish, conf.d/mise.fish,
#           functions/tt.fish, functions/pi-prune-sessions.fish,
#           functions/pi-settings-reset.fish,
#           functions/pwt.fish, functions/agents-update.fish,
#           functions/git-prune-merged.fish,
#           completions/pwt.fish
# Ignored:  everything fisher owns (functions/, completions/, conf.d/plugin-*)

functions/*
!functions/tt.fish
!functions/pi-prune-sessions.fish
!functions/pi-settings-reset.fish
!functions/pwt.fish
!functions/agents-update.fish
!functions/git-prune-merged.fish
# `completions/*`, not `completions/`: git cannot re-include a file whose PARENT
# directory is excluded, so the directory form would silently ignore pwt.fish
# regardless of the negation below (the functions/ pattern is a glob for the same
# reason).
completions/*
!completions/pwt.fish
conf.d/*
!conf.d/wsl.fish
!conf.d/ssh-agent.fish
!conf.d/ssh-locale.fish
!conf.d/mise.fish
