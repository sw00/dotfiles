#!/usr/bin/env bash
# repo-list — directories worth offering in the C-f picker, in zoxide frecency
# order (most-used first).
#
# `zoxide query -l` returns every directory zoxide has ever recorded, not repos:
# under ~/src that was 55 entries of which only 26 were git roots. The rest were
# deep subdirectories that were merely visited once (including a stray .git).
# Clearing zoxide would not help — it would lose the frecency ordering and
# re-accumulate — so the filtering belongs here.
#
# One `git rev-parse --show-toplevel` per entry answers both questions at once:
#   toplevel == the path       → it IS a repo root             → keep
#   toplevel == ""             → it is in no repo at all       → keep
#                                (navigation roots, and standalone non-repo
#                                 project dirs, which a repos-only filter would
#                                 silently hide)
#   toplevel == something else → it is a subdirectory of one   → drop (the noise)
#
# $HOME and $SRC are always emitted, last, even though zoxide has no score for
# them: a shell at ~ and a terminal in ~/src are useful regardless of frecency.
#
# Pass --stdin to filter a supplied list instead of querying zoxide, which is how
# the rule is tested. An explicit flag, not "stdin when it is not a tty": that
# heuristic silently produced nothing in scripts and CI.
#
# NOTE: the filter loop must stay at the top level. bash 3.2 (macOS /bin/bash)
# mis-parses a `case` pattern containing `|` alternation when it appears inside a
# command substitution — `filtered="$( … | while … case a|b) …)"` fails with
# "syntax error near unexpected token" and then "_d: unbound variable".
set -euo pipefail

SRC="${PWT_SRC:-$HOME/src}"

{
    if [[ "${1:-}" == "--stdin" ]]; then
        cat
    else
        zoxide query -l --base-dir "$SRC" 2>/dev/null || true
    fi
} | while IFS= read -r _d; do
    [[ -n "$_d" ]] || continue
    # Skipped here and re-emitted below, so neither root can appear twice.
    if [[ "$_d" == "$HOME" || "$_d" == "$SRC" ]]; then
        continue
    fi
    case "$_d" in
        # pwt worktrees are workstreams, not repos — C-w picks those.
        */__worktrees|*/__worktrees/*) continue ;;
        # git reports NO toplevel for paths inside a .git directory, so the rule
        # below would treat them as "in no repo" and keep them. Never navigation
        # targets.
        */.git|*/.git/*) continue ;;
    esac
    _t="$(command git -C "$_d" rev-parse --show-toplevel 2>/dev/null)" || _t=""
    if [[ -n "$_t" && "$_t" != "$_d" ]]; then
        # git returns a CANONICAL path, so a repo reached through a symlink
        # (macOS /var -> /private/var, /tmp, or any symlinked parent) compares
        # unequal to itself and would be dropped. Resolve only when they differ,
        # which in a normal tree is never — so it costs nothing.
        [[ "$_t" == "$(cd "$_d" 2>/dev/null && pwd -P)" ]] || continue
    fi
    printf '%s\n' "$_d"
done

# Always offered, and always last so fzf's default selection (the first curated
# entry) is unchanged. Home before the source root, reading outer -> inner.
# Skipped in --stdin mode, which must filter exactly the list it is given.
if [[ "${1:-}" != "--stdin" ]]; then
    for _r in "$HOME" "$SRC"; do
        if [[ -d "$_r" ]]; then
            printf '%s\n' "$_r"
        fi
    done
fi
