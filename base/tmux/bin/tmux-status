#!/bin/bash
# Consolidated tmux status script. Dispatches on uname/WSL to report the
# machine's IP addresses on a single line.
#
# The WiFi half was removed: it shelled out to `system_profiler` on macOS and
# `netsh.exe` on WSL every 20s (status-interval) to duplicate a signal the
# desktop already shows, for ~65 lines of platform-branching bash.
set -euo pipefail

ip_addresses() {
    case "$(uname -s)" in
        Darwin)
            ifconfig | awk '/inet.*([0-9]+\.)/{ print "[" $2 "] " }' | tail -1
            ;;
        Linux)
            if grep -qEi '(microsoft|wsl)' /proc/version 2>/dev/null; then
                local HOST WSL_VM
                HOST=$(powershell.exe -Command "(ipconfig.exe) -Match 'IPv4'" | tr -s '\n\r' '\n' | awk '!/172(\.[0-9]+){3}/{ print $NF }')
                WSL_VM=$(ip a | awk '/inet.*([0-9]+\.)/{ print $2 }' | tail -1)
                echo "[$HOST] [$WSL_VM]"
            else
                ip address | awk '/inet.*([0-9]+\.)/{ print "[" $2 "] " }' | grep -vE '127|172'
            fi
            ;;
        *)
            echo "Unknown platform"
            ;;
    esac
}

main() {
    echo "$(ip_addresses)"
}

main "$@"
