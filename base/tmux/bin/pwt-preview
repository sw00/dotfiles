#!/bin/bash
# pwt-preview — the C-w panel's preview for one workstream: "do I still need this?"
#
# Usage: pwt-preview <path>
#
# A SCRIPT, not an inline `--preview` string, and that is the whole point: fzf runs
# preview commands with `$SHELL -c`, and $SHELL is fish on this machine, so a POSIX
# snippet (`n=$(…)`) is a syntax error printed into the preview pane instead of a
# preview. Anything with shell syntax belongs here, where the shebang decides.
#
# Output: `git status --short --branch`, whether HEAD has landed on the default
# branch, then the commits that exist on NO remote. The last two answer what the
# status line cannot: a pwt branch is created from HEAD and has no upstream, so
# `--branch` reports `## slug` and says nothing about whether the work merged or was
# pushed. Showing only; merging stays the operator's.
set -uo pipefail

path="${1:-}"
[ -n "$path" ] || exit 0

# The panel lists live pi panes anywhere, including a session started in $HOME or
# /tmp. Those have no status to show; say so rather than rendering an empty pane that
# reads as a broken preview.
if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
    echo "not a git work tree — no workstream state to show"
    exit 0
fi

git -C "$path" status --short --branch 2>/dev/null | head -12

# "Has this landed?" — the other half of "do I still need this?", and the half the
# status line cannot answer: a pwt branch is created from HEAD and has no upstream,
# so `## slug` says nothing, and the rev-list below is 0 once a branch is pushed
# whether or not the work MERGED. One merge-base call against the default branch.
#
# The wording is "already in <ref>", not "merged": HEAD is ancestry-tested, so a
# fresh worktree sitting on the default branch with nothing committed yet also
# qualifies — true of HEAD, and the status block above is what says the tree is
# dirty. It also never claims the branch is removed: a squash-merge is not an
# ancestor, and `pwt rm` keeps the branch when git says it is unmerged. The ref is
# the LAST FETCHED one — nothing here fetches, so a merge on the remote reads as
# unlanded until you do.
default="$(git -C "$path" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
for cand in "${default:-}" origin/main origin/master; do
    [ -n "$cand" ] || continue
    if git -C "$path" rev-parse --verify --quiet "$cand" >/dev/null 2>&1; then
        default="$cand"
        break
    fi
done
if [ -n "${default:-}" ] && git -C "$path" merge-base --is-ancestor HEAD "$default" 2>/dev/null; then
    printf '\n· already in %s\n' "$default"
fi

n="$(git -C "$path" rev-list --count HEAD --not --remotes 2>/dev/null || true)"
case "$n" in ''|*[!0-9]*) n=0 ;; esac
if [ "$n" -gt 0 ]; then
    printf '\n· %s commit(s) on no remote\n' "$n"
    git -C "$path" log --oneline HEAD --not --remotes --no-merges 2>/dev/null | head -8
fi
