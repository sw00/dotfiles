# TokenTelemetry — pinned image digests and runtime settings.
# Update with: tt update  (pulls latest and records new digests here)

TT_BACKEND_IMAGE=ghcr.io/vasihemanth/tokentelemetry-backend@sha256:9bfb2894f223ccfd43250c57d4d7e2c0092dd2a5f17705eebbd927ae684e8df0
TT_FRONTEND_IMAGE=ghcr.io/vasihemanth/tokentelemetry-frontend@sha256:0c7d13084a9237d8ef8711f788083e783e0e436cdf25aa34bc96a682b1454376

# Host ports (loopback-only — no LAN exposure)
TT_BACKEND_PORT=18000
TT_FRONTEND_PORT=13000

# Data directory on host (bind-mounted, survives container recreation)
TT_DATA_DIR=${HOME}/.local/share/tokentelemetry
