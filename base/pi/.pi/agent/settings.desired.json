{
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/glm-5.3-flash",
    "opencode-go/glm-5.3"
  ],
  "rateLimitFallbacks": {},
  "rateLimitFallbackStatuses": [
    429,
    529,
    503
  ],
  "rateLimitFallbackRecoveryCooldownSec": 120,
  "providerFallbacks": {
    "opencode-go": {
      "to": "opencode",
      "match": ["active OpenCode Go subscription"]
    }
  },
  "extensions": [
    "-builtin:usage",
    "extensions/optional/infra-safety.ts",
    "extensions/optional/modes"
  ],
  "packages": [
    "npm:pi-claude-bridge@0.13.0",
    "npm:@hypabolic/pi-hypa@1.2.0",
    "npm:pi-web-access@0.48.0",
    "npm:@tmustier/pi-usage-extension@0.10.2",
    "npm:cc-safety-net@2.8.1",
    "git:github.com/DietrichGebert/ponytail@96608e078b2d5ea607c5c3b8b5a54d1c1fba6846"
  ],
  "theme": "dark"
}
