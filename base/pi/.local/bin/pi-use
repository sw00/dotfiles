#!/bin/sh
# pi-use — point the `pi` name at upstream pi or at pi-bolt.
#
# Both variants read the SAME ~/.pi/agent (config, auth, sessions, extensions,
# packages): pi-bolt ships pi's own package.json (piConfig.configDir ".pi"), so
# nothing but the binary differs. This script owns exactly one thing — the
# ~/.local/bin/pi symlink — and records the choice in ~/.pi/agent/pi-variant so
# it can tell "chosen" from "reset".
#
# No wrapper script on purpose: a shim makes pi's self-updater classify the
# install as unknown and refuse `pi update --self`; a symlink keeps every
# binary's real path intact. pi-bolt's launcher resolves itself with readlink -f
# and runs ../install.sh, so it must be reached through its own
# ~/.local/bin/pi-bolt entry (same directory, hence the relative target).
#
# Drift facts (pi 1.4.0 dist): `pi update --self` never touches
# ~/.local/bin/pi — it only writes ~/.pi/agent/install/{staging,releases,
# current-version}. What DOES reset the symlink is re-running pi.dev's
# install.sh, and bootstrap's ensure_pi when the entrypoint stops resolving
# inside ~/.pi/agent. ensure_pi reads this script's state file and leaves a
# deliberate bolt flip alone (see bootstrap.sh).
#
# A third variant, pig, is NOT a drop-in: it is a Go rewrite with no
# extension system, so flipping to it removes this repo's safety and workflow
# extensions (see set_pig's warning). It exists because sometimes you want to
# run the other implementation, not because it is interchangeable.
#
# Usage: pi-use [pi|upstream|bolt|pig|current|status]

set -eu

bin_dir=$HOME/.local/bin
pi_link=$bin_dir/pi
state_file=$HOME/.pi/agent/pi-variant
upstream_target=../../.pi/agent/bin/pi   # the relative form install.sh creates
bolt_target=pi-bolt
pig_target=pig

die() { printf 'pi-use: %s\n' "$*" >&2; exit 1; }

link_target() {
    [ -L "$pi_link" ] && readlink "$pi_link" || true
}

# Pig has no launcher of its own, so its link carries the RESOLVED binary path
# (see set_pig); identity therefore falls back to the basename for an absolute
# target. bolt and upstream are same-dir/shallow-relative links and match exactly.
is_pig_target() {
    [ "$1" = "$pig_target" ] && return 0
    case "$1" in
        /*) [ "${1##*/}" = pig ] ;;
        *) return 1 ;;
    esac
}

# The variant implied by the link itself — never by `pi --version`, which is
# human output whose wording can change between releases.
current_variant() {
    if is_pig_target "$(link_target)"; then
        echo pig
        return
    fi
    case "$(link_target)" in
        "$bolt_target") echo bolt ;;
        "$upstream_target" | "$HOME/.pi/agent/bin/pi") echo pi ;;
        *) echo unknown ;;
    esac
}

read_state() { [ -r "$state_file" ] && cat "$state_file" || true; }

write_state() {
    mkdir -p "${state_file%/*}"
    tmp=$state_file.tmp.$$
    printf '%s\n' "$1" >"$tmp"
    mv -f "$tmp" "$state_file"
}

# Never clobber something that is not our symlink: a real file at that path is
# somebody else's install, not a variant to flip.
require_our_link() {
    if [ -e "$pi_link" ] && [ ! -L "$pi_link" ]; then
        die "$pi_link is a regular file, not a pi-use symlink — refusing to replace it"
    fi
}

set_upstream() {
    [ -x "$HOME/.pi/agent/bin/pi" ] \
        || die "upstream launcher $HOME/.pi/agent/bin/pi is missing — run pi.dev's install.sh"
    require_our_link
    ln -sfn "$upstream_target" "$pi_link"
    write_state pi
    echo "pi-use: pi -> upstream (managed install)"
}

set_bolt() {
    # Validate BEFORE flipping: the pi-bolt launcher needs its sibling
    # install.sh, since it resolves itself and then runs ../install.sh.
    [ -e "$bin_dir/pi-bolt" ] \
        || die "$bin_dir/pi-bolt is missing — npm install -g --prefix ~/.local pi-bolt"
    resolved=$(readlink -f "$bin_dir/pi-bolt") || die "cannot resolve $bin_dir/pi-bolt"
    [ -x "$resolved" ] || die "$resolved is not executable"
    [ -f "${resolved%/*}/../install.sh" ] \
        || die "no install.sh beside the pi-bolt launcher — wrong install shape?"
    require_our_link
    ln -sfn "$bolt_target" "$pi_link"
    write_state bolt
    echo "pi-use: pi -> pi-bolt (running pi sessions keep their binary; new ones use bolt)"
}

set_pig() {
    # pig is a behaviour-compatible *rewrite*, not the same program: no
    # extension system at all (upstream pi's Node-sidecar API is unimplemented
    # there), and its own config dir. Allowed, but never quietly.
    if [ -x "$bin_dir/pig" ]; then
        pig_bin=$bin_dir/pig
    else
        pig_bin=$(command -v pig 2>/dev/null) \
            || die "pig is not installed — mise use -g go, then: go install github.com/ZoroSpace/pig/cmd/pig@latest"
    fi
    [ -x "$pig_bin" ] || die "$pig_bin is not executable"
    require_our_link
    # Link the RESOLVED path, not the same-dir name: pig comes from `go install`
    # (~/go/bin, usually not ~/.local/bin), so a relative `pig` target would
    # dangle and leave `pi` unrunnable. It is a plain binary, not a launcher, so
    # an absolute target is safe here — unlike bolt, which resolves itself.
    ln -sfn "$pig_bin" "$pi_link"
    write_state pig
    {
        echo "pi-use: pi -> pig ($pig_bin)"
        echo "pi-use: WARNING — pig has no extension system. Not loaded under it:"
        echo "pi-use:   infra-safety (the locked/armed write gate), subagent,"
        echo "pi-use:   model-switch, usage, hypa, web-search, claude-bridge."
        echo "pi-use:   Infra mutations are therefore UNGATED while pig is active."
        echo "pi-use: pig also reads ~/.pig/agent, not ~/.pi/agent: sessions are"
        echo "pi-use:   JSONL-compatible, settings/models are not shared unless you"
        echo "pi-use:   link them yourself. Verified providers there: DeepSeek,"
        echo "pi-use:   Volcengine Ark, Google (partial). Your default is opencode-go."
        echo "pi-use: flip back with: pi-use pi   (or pi-use bolt)"
    } >&2
}

show_status() {
    have=$(current_variant)
    want=$(read_state)
    target=$(link_target)
    ver=$(command pi --version 2>/dev/null || echo 'pi not runnable')
    printf 'link:    %s -> %s\n' "$pi_link" "${target:-MISSING}"
    printf 'variant: %s\n' "$have"
    printf 'running: %s\n' "$ver"
    # Degraded variants say so in the status line, not only at flip time.
    if [ "$have" = pig ]; then
        printf 'degraded: %s\n' \
            'pig has no extension system — infra-safety, subagent, model-switch, usage, hypa NOT loaded'
    fi
    # First run on a machine nobody recorded a choice on: adopt what is there.
    if [ -z "$want" ] && [ "$have" != unknown ]; then
        write_state "$have"
        want=$have
        echo "state:    adopted $have (no previous choice recorded)"
    fi
    [ "$have" != unknown ] \
        || die "drift: $pi_link is not a pi-use symlink — fix with: pi-use pi | pi-use bolt"
    if [ -n "$want" ] && [ "$want" != "$have" ]; then
        die "drift: choice was $want but the link says $have (install.sh or bootstrap reset it?) — fix with: pi-use $want"
    fi
}

case ${1:-status} in
    pi | upstream) set_upstream ;;
    bolt) set_bolt ;;
    pig) set_pig ;;
    current) current_variant ;;
    status) show_status ;;
    *) die "usage: pi-use [pi|upstream|bolt|pig|current|status]" ;;
esac
