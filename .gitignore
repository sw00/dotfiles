vim/.netrwhist
*.swp
*.log
.aider*

**/tmux/plugins

# Fish runtime state (machine-specific, managed by fish itself)
**/fish/fish_variables

# Fish package: fisher writes plugin files at runtime, so only our own files are
# tracked. This allowlist lives HERE, not inside base/fish/, because a .gitignore
# inside a stow package gets linked into the live tree (~/.config/fish/.gitignore)
# — it is a repo artifact, not config. Patterns are anchored at base/fish/; a
# negation cannot re-include a file whose PARENT dir is excluded, hence
# `functions/*` rather than `functions/`.
# Tracked: config.fish, fish_plugins, conf.d/{ssh-agent,ssh-locale,wsl,mise}.fish,
#          functions/{tt,pi-prune-sessions,pi-settings-apply,pwt,agents-update,
#          git-prune-merged}.fish, completions/pwt.fish
# A NEW own-file is invisible until it is negated below — check.sh asserts one
# negation per own-file for exactly that reason.
base/fish/.config/fish/functions/*
!base/fish/.config/fish/functions/tt.fish
!base/fish/.config/fish/functions/pi-prune-sessions.fish
!base/fish/.config/fish/functions/pi-settings-apply.fish
!base/fish/.config/fish/functions/pwt.fish
!base/fish/.config/fish/functions/agents-update.fish
!base/fish/.config/fish/functions/git-prune-merged.fish
base/fish/.config/fish/completions/*
!base/fish/.config/fish/completions/pwt.fish
base/fish/.config/fish/conf.d/*
!base/fish/.config/fish/conf.d/wsl.fish
!base/fish/.config/fish/conf.d/ssh-agent.fish
!base/fish/.config/fish/conf.d/ssh-locale.fish
!base/fish/.config/fish/conf.d/mise.fish
# pi session captures (transient, machine-local)
pi-session-*.html

# Scratch clones (work repos cloned locally, not dotfiles content)
/src/
