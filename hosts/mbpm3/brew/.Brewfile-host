# ── Native compiled dependencies ──────────────────────────────────────────────
# Libraries that Python/other packages link against at the C level.
# mise provides cross-platform binaries but not .dylib / header files.
brew "libpq"     # PostgreSQL client lib (psycopg2, asyncpg, etc.)
brew "ffmpeg"    # Audio/video processing

# ── Desktop apps ──────────────────────────────────────────────────────────────
cask "audacity"
cask "bruno"
# Caffeine also sits in bootstrap.sh's migrate_app_trim() trimmed list (the
# 2026-07 lean pass removed it). Declaring it here means it has to be out of that
# array — otherwise every bootstrap installs it and then uninstalls it again.
# Host-scoped on purpose: only this Mac needs a keep-awake utility, and it has no
# winget counterpart, so it does not belong in Brewfile-base's parity table.
cask "caffeine"             # keep-awake utility
cask "discord"
cask "freelens"
cask "linear"
cask "loom"
cask "macfuse"
cask "mounty"

# ── Containers ────────────────────────────────────────────────────────────────
# colima replaces Docker Desktop: headless Lima VM instead of Electron + VM GUI.
# bootstrap.sh migrate_app_trim() finishes the move: uninstalls docker-desktop,
# links the CLI plugins into ~/.docker/cli-plugins, and starts the VM.
# Tip: 'brew services start colima' to auto-start the VM on login.
brew "colima"
brew "docker"           # docker CLI client
brew "docker-compose"   # compose plugin
brew "docker-buildx"    # buildx plugin
# Required, not optional: ~/.docker/config.json sets credsStore=osxkeychain, so
# this is what resolves registry credentials for colima/docker. Deleting it (as
# the first audit recommended) would silently break auth to ghcr.io and friends.
brew "docker-credential-helper"
cask "pycharm"
cask "tomighty"
cask "vlc"
cask "jan"
cask "notion"
cask "readest"              # EPUB ebook reader
cask "signal"               # Secure messaging
cask "microsoft-teams"      # Work messaging
cask "microsoft-outlook"    # Work mail — teams was declared without it, an oversight
cask "windows-app"          # Microsoft RDP client (work)
cask "openusage"            # AI usage tracker (the desktop app; the CLI form is separate)
cask "monokle"              # Kubernetes config UI
cask "zoom"                 # work meetings — used ~weekly; auto_updates (tier 3)
cask "dbeaver-community"    # DB client — used monthly; was dmg-installed, bundle --adopt owns it
# Tailscale is deliberately NOT the cask: installed via the standalone pkg
# (com.tailscale.ipn.macsys — root-owned /usr/local/bin/tailscale shim), which
# self-updates. Same self-managed class as Claude.app. Recorded so the audit
# doesn't re-flag it.
# Claude desktop app is deliberately NOT casked: same self-managed class as the
# pi/claude CLIs (its updater owns /Applications/Claude.app). Recorded here so
# the quarterly audit doesn't re-flag it as unowned.
# MeetingReminder (github.com/adamswbrown/meeting-reminder) is tapless too:
# no cask exists and brew rejects a dotfiles-hosted tap dir, so
# bootstrap.sh's ensure_meeting_reminder seeds the pinned, sha256-verified
# release DMG (and is the upgrade path — the app has no self-updater).
# check.sh guards the pin pair and keeps this file cask-free for it.

# ── CLI tools with no mise backend ────────────────────────────────────────────
# No mise registry entry and no usable ubi release, so brew owns them. Declared
# only after the audit found them installed-and-undeclared — declared HERE rather
# than in Brewfile-base so as not to imply a Linux/ensure_system_tools twin.
# goaccess replaced by lnav (mise, aqua:tstack/lnav); inframap deleted —
# project-level tool, belongs in the work repo's mise config, not here.
brew "telnet"               # nc is not equivalent; small and occasionally needed

