# ── Native compiled dependencies ──────────────────────────────────────────────
# Libraries that Python/other packages link against at the C level.
# mise provides cross-platform binaries but not .dylib / header files.
brew "libpq"     # PostgreSQL client lib (psycopg2, asyncpg, etc.)
brew "ffmpeg"    # Audio/video processing

# ── Desktop apps ──────────────────────────────────────────────────────────────
cask "audacity"
cask "bruno"
cask "discord"
cask "freelens"
cask "linear"
cask "loom"
cask "macfuse"
cask "mounty"

# ── Containers ────────────────────────────────────────────────────────────────
# colima replaces Docker Desktop: headless Lima VM instead of Electron + VM GUI.
# bootstrap.sh migrate_app_trim() finishes the move: uninstalls docker-desktop,
# links the CLI plugins into ~/.docker/cli-plugins, and starts the VM.
# Tip: 'brew services start colima' to auto-start the VM on login.
brew "colima"
brew "docker"           # docker CLI client
brew "docker-compose"   # compose plugin
brew "docker-buildx"    # buildx plugin
# Required, not optional: ~/.docker/config.json sets credsStore=osxkeychain, so
# this is what resolves registry credentials for colima/docker. Deleting it (as
# the first audit recommended) would silently break auth to ghcr.io and friends.
brew "docker-credential-helper"
cask "pycharm"
cask "tomighty"
cask "vlc"
cask "jan"
cask "notion"
cask "readest"              # EPUB ebook reader
cask "signal"               # Secure messaging
cask "microsoft-teams"      # Work messaging
cask "microsoft-outlook"    # Work mail — teams was declared without it, an oversight
cask "windows-app"          # Microsoft RDP client (work)
cask "openusage"            # AI usage tracker (the desktop app; the CLI form is separate)
cask "monokle"              # Kubernetes config UI

# ── CLI tools with no mise backend ────────────────────────────────────────────
# No mise registry entry and no usable ubi release, so brew owns them. Declared
# only after the audit found them installed-and-undeclared — declared HERE rather
# than in Brewfile-base so as not to imply a Linux/ensure_system_tools twin.
brew "goaccess"             # web log analyzer
brew "inframap"             # terraform/state graph generator
brew "hf"                   # Hugging Face CLI (a Python tool, no registry entry)
brew "telnet"               # nc is not equivalent; small and occasionally needed

